# Microsoft Foundry resource endpoint.
FOUNDRY_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/

# Full Azure resource ID for Microsoft Entra authentication.
FOUNDRY_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<resource-name>

# Before running the generator, authenticate with `az login` using an identity
# that has permission to access this Foundry resource.
